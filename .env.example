# Local development only. Change all passwords and the secret before deployment.
DJANGO_SECRET_KEY=local-development-change-this-secret-before-deploying
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=false
DJANGO_SSL_REDIRECT=false
MYSQL_DATABASE=textbench
MYSQL_USER=textbench
MYSQL_PASSWORD=local-textbench-password
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
APP_PORT=8000
